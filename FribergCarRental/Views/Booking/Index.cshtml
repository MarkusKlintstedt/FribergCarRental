@model IEnumerable<FribergCarRental.Models.BookingViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Your bookings</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Car</th>
            <th>Start date</th>
            <th>Return date</th>
            <th>Days</th>
            <th>Cost per day</th>
            <th>Total cost</th>
            <th></th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Car.DisplayBrandModel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentEndDate)
            </td>
            <td>
                @(item.RentEndDate.DayNumber - item.RentStartDate.DayNumber + 1)
            </td>
            <td>
                @(item.Car.RentPricePerDay) kr
            </td>
            <td>
                @((item.RentEndDate.DayNumber - item.RentStartDate.DayNumber + 1) * item.Car.RentPricePerDay) kr
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
