@model FribergCarRental.Models.BookingViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Car
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.Brand) @Html.DisplayFor(model => model.Car.ModelName)
        </dd>
        <dt class = "col-sm-2">
            Start date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RentStartDate)
        </dd>
        <dt class = "col-sm-2">
            Return date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RentEndDate)
        </dd>
        <dt class="col-sm-2">
            Number of days
        </dt>
        <dd class="col-sm-10">
            @(Model.RentEndDate.DayNumber-Model.RentStartDate.DayNumber+1)
        </dd>
        <dt class="col-sm-2">
            Cost per day 
        </dt>
        <dd class="col-sm-10">
            @Model.Car.RentPricePerDay kr
        </dd>
        <dt class="col-sm-2">
            Total cost
        </dt>
        <dd class="col-sm-10">
            @((Model.RentEndDate.DayNumber - Model.RentStartDate.DayNumber + 1)*Model.Car.RentPricePerDay) kr
        </dd>



    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.BookingId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
