@model FribergCarRental.Models.BookingViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Book a car</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CarId" class="control-label">Car</label>
                <br />
                <select asp-for="CarId" class="control-label" asp-items="ViewBag.Cars"></select>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="RentStartDate" class="control-label">Start date</label>
                <input asp-for="RentStartDate" type="date" class="form-control" />
                <span asp-validation-for="RentStartDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label asp-for="RentEndDate" class="control-label">Return date</label>
                <input asp-for="RentEndDate" type="date" class="form-control" />
                <span asp-validation-for="RentEndDate" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
