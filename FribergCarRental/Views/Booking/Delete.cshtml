@model FribergCarRental.Models.BookingViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Car
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Car.DisplayBrandModel)
        </dd>
        <dt class = "col-sm-2">
            Start date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RentStartDate)
        </dd>
        <dt class = "col-sm-2">
            Return date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RentEndDate)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="BookingId" />
        <input type="submit" value="Delete booking" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
