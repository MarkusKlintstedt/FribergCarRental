@model FribergCarRental.Models.UserViewModel

@{
    ViewData["Title"] = "DeleteUser";
}

<h1>Are you sure you want to delete this user?</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            User name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
         <dt class = "col-sm-2">
            Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)  @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            Address
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address), 
            @Html.DisplayFor(model => model.ZipCode) @Html.DisplayFor(model => model.City)
        </dd>
        <dt class="col-sm-2">
            Phone number
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.PhoneNumber)  
        </dd>


     </dl>
    
    <form asp-action="DeleteUser">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <br />
        <a asp-action="Users">Back to list of users</a>
        <br />
        <a asp-action="Index">Back to main admin page</a>
    </form>
</div>
