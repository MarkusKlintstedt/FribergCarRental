@model IEnumerable<FribergCarRental.Models.BookingViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Bookings</h1>

<table class="table">
    <thead>
        <tr>
            <th>Car</th>
            <th>Rented by</th>
            <th>Start date</th>
            <th>Return date</th>
            <th>Days</th>
            <th>Cost per day</th>
            <th>Total cost</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Car.DisplayBrandModel)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ApplicationUser.FirstName) @Html.DisplayFor(modelItem => item.ApplicationUser.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RentStartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RentEndDate)
                </td>
                <td>
                    @(item.RentEndDate.DayNumber-item.RentStartDate.DayNumber+1)
                </td>
                <td>
                    @(item.Car.RentPricePerDay) kr
                </td>
                <td>
                    @((item.RentEndDate.DayNumber - item.RentStartDate.DayNumber + 1)*item.Car.RentPricePerDay) kr
                </td>
                <td>
                    <a asp-action="DeleteBooking" asp-route-id="@item.BookingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-controller="Admin" asp-action="Index">Back to main admin page</a>
</div>

