@model IEnumerable<FribergCarRental.Models.UserViewModel>

@{
    ViewData["Title"] = "Users";
}

<h1>List of users</h1>

<p>
    <a asp-action="CreateUser">Create new user</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email/User name</th>
            <th>Address</th>
             <th>Phone number</th>
             <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName) 
                    @Html.DisplayFor(modelItem => item.LastName) 
                </td >
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
             <td>
                    @Html.DisplayFor(modelItem => item.Address),
                    @Html.DisplayFor(modelItem => item.ZipCode)
                    @Html.DisplayFor(modelItem => item.City) 
             </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>

            <td>
                <a asp-action="EditUser" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="DeleteUser" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-controller="Admin" asp-action="Index">Back to main admin page</a>
</div>
