@model IEnumerable<CarViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Cars</h1>

<p>
    @* <a asp-action="Create">Create New</a> *@
</p>
<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                Car
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                Price per day
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @if (item.Images != null && item.Images.Any())
                {
                    string imgPath = item.Images.First().Path;
                    <img src="@imgPath" alt="Car image" style="max-height:100px;" />
                }
                else
                {
                    <span>No image available</span>
                }
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Brand) @Html.DisplayFor(modelItem => item.ModelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RentPricePerDay) kr
            </td>
            <td>
                @* <a asp-action="Edit" asp-route-id="@item.CarId">Edit</a> | *@
                <a asp-action="Details" asp-route-id="@item.CarId">Details</a> |
                <a asp-action="Images" asp-route-id="@item.CarId">Images</a> 
            </td>
        </tr>
}
    </tbody>
</table>
