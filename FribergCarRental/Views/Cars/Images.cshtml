@model CarViewModel

@{
    ViewData["Title"] = "Images";
}

<h2>Images for @Model.Brand @Model.ModelName</h2>
<br />
<br />


<table class="table">
    <thead>
        <tr>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var image in Model.Images)
        {
            <tr>
                <td>
                    <img src="@image.Path" alt="Car image" />
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index">Back to list of cars</a>
</div>

